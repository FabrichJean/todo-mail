# Référence de toutes les variables utilisées par l'app. En pratique, elles vivent
# toutes dans un seul fichier .env non commité, chargé par Next.js quelle que soit
# la commande (dev ou prod) et par prisma.config.ts pour la CLI Prisma.

# Base de données (SQLite en dev, adapter en prod si besoin)
DATABASE_URL="file:./dev.db"

# OAuth Google — https://console.cloud.google.com/apis/credentials
# Les redirect URIs ci-dessous doivent être ajoutées telles quelles dans les
# "Authorized redirect URIs" du client OAuth sur la console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connexion automatique d'un compte Gmail d'envoi (scope gmail.send)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback
# Connexion à la plateforme (identité uniquement, "Se connecter avec Google")
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Clé de chiffrement des identifiants stockés (32 octets en base64).
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Accès à /admin : connexion Google identique au reste de l'app, mais seule l'adresse
# ci-dessous voit le lien Admin, et il faut en plus confirmer ADMIN_PASSWORD (propre à
# chaque environnement) pour déverrouiller la zone.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Notifications (nouvel utilisateur, email envoyé) vers un service Notifier personnel
# (voir /Users/md/Documents/notifier). NOTIFIER_TOKEN doit être une clé API (préfixe nk_,
# générée par `create-api-key` sur le serveur Notifier) — pas un token d'appareil (dv_).
# Optionnel : sans NOTIFIER_SERVER_URL/NOTIFIER_TOKEN, les notifications sont désactivées.
# NOTIFIER_DEVICE_ID (optionnel, préfixe dv_, via `create-device`) cible un seul appareil —
# omis, la notification est diffusée à tous les appareils connectés.
NOTIFIER_SERVER_URL=
NOTIFIER_TOKEN=
NOTIFIER_DEVICE_ID=
