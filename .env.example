# Référence de toutes les variables utilisées par l'app. En pratique, réparties dans
# deux fichiers non commités et chargés automatiquement par Next.js selon la commande :
#   .env.development → next dev
#   .env.production   → next build / next start
# Seules GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (partagées) vivent dans .env.

# Base de données (SQLite en dev, adapter en prod si besoin)
DATABASE_URL="file:./dev.db"

# OAuth Google — https://console.cloud.google.com/apis/credentials
# Même client OAuth pour les deux usages, une paire de redirect URIs par environnement
# à ajouter dans la console (dev en http://localhost:3000/..., prod en https://ton-domaine.com/...).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connexion automatique d'un compte Gmail d'envoi (scope gmail.send)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback
# Connexion à la plateforme (identité uniquement, "Se connecter avec Google")
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Clé de chiffrement des identifiants stockés (32 octets en base64) — une clé PAR
# environnement, ne jamais réutiliser celle du dev en prod.
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
